# Kopieren nach .env und Werte setzen.
# Zufallswerte erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Hostnamen/IPs, unter denen die Web-UI aufgerufen wird
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Öffentliche HTTPS-Adresse(n) hinter dem Reverse Proxy, z. B. https://osint.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cookies nur über HTTPS senden (0 = auch über http, nur für Tests)
DJANGO_SECURE_COOKIES=1

# Erster Benutzer, wird beim Start angelegt, falls noch nicht vorhanden
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=

# Port/Interface der Web-UI auf dem Host (für reines LAN die LAN-IP eintragen)
APP_BIND=0.0.0.0
APP_PORT=8080

POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=

SEARXNG_SECRET=

# KI
OLLAMA_URL=http://192.168.1.139:11434
OLLAMA_MODEL=qwen3:8b

# Standardland für Rufnummern ohne Ländervorwahl
DEFAULT_REGION=DE

# Optionale kostenlose API-Keys
ABUSEIPDB_KEY=
GREYNOISE_KEY=

# Reverse Proxy(s), deren X-Forwarded-For-Header vertraut wird (für die Login-Sperre)
TRUSTED_PROXIES=192.168.1.200
