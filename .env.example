# Copy this file to .env and configure the values.
# Generate random secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Hostnames and IP addresses through which the web interface is served
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public HTTPS origin(s) behind the reverse proxy, for example https://osint.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Send cookies only over HTTPS (set to 0 only for HTTP testing)
DJANGO_SECURE_COOKIES=1

# Initial account, created at startup if it does not exist
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=

# Host port and interface for the web service; use the LAN address for LAN-only access
APP_BIND=0.0.0.0
APP_PORT=8080

POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=

SEARXNG_SECRET=

# Outbound email for invitations, confirmation, and password reset.
# Without EMAIL_HOST, messages are written only to the web-container log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 = STARTTLS (EMAIL_USE_TLS=1), 465 = SSL (EMAIL_USE_SSL=1)
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Who Are You <noreply@example.org>

# Local language model
OLLAMA_URL=http://192.168.1.139:11434
OLLAMA_MODEL=qwen3:8b

# Default country for phone numbers without a country code
DEFAULT_REGION=DE

# Optional free API keys
ABUSEIPDB_KEY=
GREYNOISE_KEY=

# Reverse proxies whose X-Forwarded-For header is trusted for login lockout
TRUSTED_PROXIES=192.168.1.200

# Additional free reputation sources, enabled when their key is configured
# https://www.virustotal.com/gui/join-us
VIRUSTOTAL_KEY=
# https://otx.alienvault.com (works without a key; a key raises the limits)
OTX_KEY=
# https://auth.abuse.ch (one key covers ThreatFox and URLhaus)
ABUSECH_KEY=
# https://app.crowdsec.net (CTI-API-Key)
CROWDSEC_KEY=

# Authentication token for the tools container (whois/dig/openssl/curl); generate with secrets.token_urlsafe(32)
TOOLS_TOKEN=

# Censys Platform (https://platform.censys.io, free account): create a personal access token under Account -> API.
# The free plan provides 100 monthly credits for lookups. Leave CENSYS_ORG_ID empty for an individual free account;
# otherwise use the organization UUID from account settings, not its display name.
CENSYS_TOKEN=
CENSYS_ORG_ID=
# Monthly request ceiling that protects the free credit allowance
CENSYS_MONTHLY_LIMIT=50
