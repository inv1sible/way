# Kopieren nach .env und Werte setzen.
# Zufallswerte erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Hostnamen/IPs, unter denen die Web-UI aufgerufen wird
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Öffentliche HTTPS-Adresse(n) hinter dem Reverse Proxy, z. B. https://osint.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cookies nur über HTTPS senden (0 = auch über http, nur für Tests)
DJANGO_SECURE_COOKIES=1

# Erster Benutzer, wird beim Start angelegt, falls noch nicht vorhanden
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=

# Port/Interface der Web-UI auf dem Host (für reines LAN die LAN-IP eintragen)
APP_BIND=0.0.0.0
APP_PORT=8080

POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=

SEARXNG_SECRET=

# Mailversand (Einladungen, E-Mail-Bestätigung, Passwort vergessen).
# Ohne EMAIL_HOST werden Mails nur ins Log des Web-Containers geschrieben.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 = STARTTLS (EMAIL_USE_TLS=1), 465 = SSL (EMAIL_USE_SSL=1)
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Who Are You <noreply@example.org>

# KI
OLLAMA_URL=http://192.168.1.139:11434
OLLAMA_MODEL=qwen3:8b

# Standardland für Rufnummern ohne Ländervorwahl
DEFAULT_REGION=DE

# Optionale kostenlose API-Keys
ABUSEIPDB_KEY=
GREYNOISE_KEY=

# Reverse Proxy(s), deren X-Forwarded-For-Header vertraut wird (für die Login-Sperre)
TRUSTED_PROXIES=192.168.1.200

# Weitere kostenlose Reputationsquellen (jeweils aktiv, sobald der Key gesetzt ist)
# https://www.virustotal.com/gui/join-us
VIRUSTOTAL_KEY=
# https://otx.alienvault.com (funktioniert auch ohne Key, mit Key höhere Limits)
OTX_KEY=
# https://auth.abuse.ch (ein Key für ThreatFox und URLhaus)
ABUSECH_KEY=
# https://app.crowdsec.net (CTI-API-Key)
CROWDSEC_KEY=

# Zugangsschutz des tools-Containers (whois/dig/openssl/curl), z. B. mit secrets.token_urlsafe(32) erzeugen
TOOLS_TOKEN=

# Censys Platform (https://platform.censys.io, Gratis-Konto): Personal Access Token unter Account -> API,
# Gratis: 100 Credits im Monat, nur Nachschläge. CENSYS_ORG_ID beim Gratis-Konto leer lassen (dann zählen die
# persönlichen Credits); sonst die UUID der Organisation aus den Kontoeinstellungen, nicht ihr Name.
CENSYS_TOKEN=
CENSYS_ORG_ID=
# Obergrenze der Abfragen pro Monat (Notbremse für das Gratis-Kontingent)
CENSYS_MONTHLY_LIMIT=50
